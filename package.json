{
  "name": "@zygrec/moncash",
  "version": "1.0.0",
  "description": "The secure, official-quality Node.js SDK for Digicel MonCash payments in Haiti",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "jest --coverage --testTimeout 100000",
    "coveralls": "coveralls < coverage/lcov.info",
    "release": "standard-version",
    "prepare": "husky install"
  },
  "keywords": [
    "moncash",
    "digicel",
    "haiti",
    "payment",
    "api",
    "sdk",
    "monnaie",
    "htg"
  ],
  "author": "Schneider Joseph <contact@zygrec.com>",
  "license": "GPL-3.0 License",
  "homepage": "https://zygrec.com",
  "bugs": {
    "url": "https://github.com/schneiderjoseph/moncash/issues"
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/node_modules/axios/dist/node/axios.cjs"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-angular": "^12.0.1",
    "coveralls": "^3.1.0",
    "husky": "^5.2.0",
    "jest": "^26.6.3",
    "nock": "^13.5.4",
    "standard-version": "^9.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schneiderjoseph/moncash.git"
  }
}
